# Copia este fichero a .env y ajusta los valores:  cp .env.example .env

# Contrasena de acceso web. Obligatoria en la primera instalacion.
KMTRACKER_PASSWORD=cambia-esta-contrasena

# Bot de Telegram (opcional). Tambien se puede configurar en /admin.
TELEGRAM_TOKEN=
# IDs de Telegram autorizados, separados por comas (recomendado).
TELEGRAM_ALLOWED_USER_IDS=

# Zona horaria
TZ=Europe/Madrid

# Rotacion de las copias de seguridad locales
KM_BACKUP_KEEP_COUNT=10
KM_BACKUP_KEEP_DAYS=30
